process {
    executor = 'local'
    cpus = 4
    memory = '16 GB'
    time = '8h'
    errorStrategy = 'terminate'

    withName: WFMASH_FAMILY_ALIGNMENT {
        cpus = 64
        memory = '128 GB'
        time = '24h'
    }

    withName: RUN_CHR22Q_LCR_ANALYSIS {
        cpus = 8
        memory = '32 GB'
        time = '8h'
    }
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            clusterOptions = '--output=slurm-%x-%j.out --error=slurm-%x-%j.err'
        }
    }
}
